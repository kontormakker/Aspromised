function friendly(){const q=quotes();const lines=['Hej.','','Jeg vil gerne have hj\u00e6lp til at afklare en forskel mellem det, vi aftalte, og det materiale jeg har bagefter.',''];if(q.length)q.forEach(x=>lines.push(`- Det lovede: "${x.before}"\n  Det der skete: "${x.after||'ikke dokumenteret i mit materiale'}"`));else lines.push('- Vil I bekr\u00e6fte, at det leverede og den endelige pris stemmer med vores aftale?');lines.push('','Vil I forklare forskellen og foresl\u00e5, hvordan vi f\u00e5r det afklaret?','','P\u00e5 forh\u00e5nd tak.');return lines.join('\n')}
function rules(type){const p=priceType();if(type==='handvaerker'){if(p==='max')return['En aftalt maksimumpris m\u00e5 if\u00f8lge Forbrug.dk ikke overskrides uden din accept af, at arbejdet bliver dyrere.','\u00c6ndringer og till\u00e6gsarbejde b\u00f8r aftales med betydningen for pris og tid, gerne skriftligt.'];if(p==='estimate')return['Et overslag er en cirkapris, ikke det samme som et bindende tilbud.','Hvis h\u00e5ndv\u00e6rkeren kan se, at overslaget ikke holder, b\u00f8r du blive orienteret, s\u00e5 I kan aftale det videre forl\u00f8b.'];if(p==='offer')return['Et tilbud er bindende for det arbejde og de leverancer, tilbuddet omfatter.','Aftalte \u00e6ndringer eller forhold uden for tilbuddet kan have betydning, s\u00e5 en prisforskel alene beviser ikke, at fakturaen er forkert.'];return['Det afg\u00f8rende er f\u00f8rst, om prisen var et tilbud, et overslag, en maksimumpris eller arbejde efter regning.','AsPromised kan ikke se aftaletypen sikkert nok til et fast svar.'];}
 if(type==='vaerksted'){if(p==='max')return['En aftalt maksimumpris m\u00e5 normalt ikke overskrides.','Hvis en h\u00f8jere pris senere er aftalt, er dokumentation for den nye aftale vigtig.'];if(p==='estimate')return['Et prisoverslag er ikke en fast pris. Hvis prisen v\u00e6sentligt vil overskride overslaget, skal reparat\u00f8ren if\u00f8lge Forbrug.dk kontakte dig og f\u00e5 accept af den h\u00f8jere pris.','Det er vigtigt, hvad I faktisk aftalte, f\u00f8r reparationen blev udf\u00f8rt.'];return['Det afg\u00f8rende er, om I aftalte fast pris, prisoverslag, maksimumpris eller ingen bestemt pris.','AsPromised g\u00e6tter ikke p\u00e5 aftaletypen.'];}
