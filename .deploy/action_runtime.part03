function copyText(t){navigator.clipboard?.writeText(t).then(()=>{}).catch(()=>{});}
function showFriendly(){const c=$a('actionCard'),t=friendly();c.innerHTML=`<h3>Venlig foresp\u00f8rgsel</h3><p class="action-note">En rolig f\u00f8rste henvendelse baseret p\u00e5 forskellene.</p><div class="action-copy"></div><div class="toolbar"><button id="apCopy">Kopi\u00e9r besked</button></div>`;c.querySelector('.action-copy').textContent=t;c.classList.add('show');$a('apCopy').onclick=()=>copyText(t)}
function showRights(type=detectType()){const c=$a('actionCard'),g=AP_GUIDES[type]||AP_GUIDES.andet,rs=rules(type),d=firmDraft(type),types=[['handvaerker','H\u00e5ndv\u00e6rker'],['vaerksted','V\u00e6rksted'],['webshop','Webshop'],['abonnement','Abonnement'],['andet','Andet']];c.innerHTML=`<h3>Dine rettigheder som kunde</h3><p class="action-note">AsPromised tror, sagen handler om <strong>${esc(g.label)}</strong>. Ret det med \u00e9t klik, hvis det er forkert.</p><div class="scenario-row">${types.map(([k,l])=>`<button data-aptype="${k}" class="secondary ${k===type?'active':''}">${l}</button>`).join('')}</div><div class="rights-box">${rs.map(x=>`<div class="rights-item">${esc(x)}</div>`).join('')}</div>${g.url?`<p class="action-note">Kilde kontrolleret ${AP_SOURCE_DATE}: <a class="rights-source" target="_blank" rel="noopener noreferrer" href="${g.url}">Forbrug.dk \u2197</a></p>`:''}<div class="legal-guard">Generel forbrugerinformation, ikke en afg\u00f8relse af din sag. AsPromised kan ikke se mundtlige aftaler, forhold uden for dine filer eller alle juridiske undtagelser.</div><h3 style="margin-top:16px">Forslag til svar</h3><div class="action-copy" id="apFirm"></div><div class="toolbar"><button id="apCopyFirm">Kopi\u00e9r svar</button></div>`;c.querySelector('#apFirm').textContent=d;c.classList.add('show');c.querySelectorAll('[data-aptype]').forEach(b=>b.onclick=()=>showRights(b.dataset.aptype));$a('apCopyFirm').onclick=()=>copyText(d)}
