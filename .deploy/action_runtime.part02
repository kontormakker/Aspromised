 if(type==='webshop')return['Hvis ingen anden leveringsfrist er aftalt, skal en dansk/EU-webshop normalt levere inden 30 dage. Ved forsinkelse kan du normalt give en ny rimelig frist; leveres der stadig ikke, kan k\u00f8bet i visse tilf\u00e6lde h\u00e6ves.','Forbrug.dk anbefaler, at du kontakter webshoppen skriftligt, s\u00e5 dit fors\u00f8g p\u00e5 at l\u00f8se sagen kan dokumenteres.'];
 if(type==='abonnement')return['Vilk\u00e5r om \u00e6ndringer skal v\u00e6re klare, og \u00e6ndringer skal varsles i rimelig tid.','Ved v\u00e6sentlige \u00e6ndringer, fx en v\u00e6sentlig prisstigning, skal du normalt kunne komme ud af abonnementet, f\u00f8r \u00e6ndringen f\u00e5r virkning. En lovet fast pris i en bestemt periode kan normalt ikke h\u00e6ves i perioden.'];
 return['AsPromised kan ikke sikkert placere sagen i en af de kildekontrollerede kategorier endnu.','V\u00e6lg en kategori ovenfor, hvis du ved, hvilken type sag det er. Ellers er den venlige foresp\u00f8rgsel det sikreste n\u00e6ste skridt.']}
function firmDraft(type){const q=quotes();const p=priceType();let line='Vil I forklare forskellen og sende den aftale eller dokumentation, som I mener begrunder den?';if(type==='handvaerker'&&p==='max')line='Forbrug.dk oplyser, at en aftalt maksimumpris ikke m\u00e5 overskrides uden kundens accept. Jeg kan ikke se dokumentation for min accept af en h\u00f8jere pris. Vil I sende den aftale, I mener giver grundlag for bel\u00f8bet, eller korrigere fakturaen?';else if(type==='handvaerker'&&p==='offer')line='Forbrug.dk oplyser, at et tilbud er bindende for det arbejde, tilbuddet omfatter. Vil I forklare prisforskellen og vise, hvor eventuelle \u00e6ndringer eller till\u00e6gsarbejder blev aftalt?';else if(type==='vaerksted'&&p==='estimate')line='Forbrug.dk oplyser, at hvis et prisoverslag v\u00e6sentligt vil blive overskredet, skal kunden kontaktes og acceptere den h\u00f8jere pris. Vil I oplyse, hvorn\u00e5r den h\u00f8jere pris blev aftalt?';else if(type==='abonnement')line='Vil I oplyse, hvorn\u00e5r og hvordan denne \u00e6ndring blev varslet, og hvilket aftalevilk\u00e5r I st\u00f8tter den p\u00e5?';else if(type==='webshop')line='Jeg beder jer bekr\u00e6fte, hvordan og hvorn\u00e5r I vil l\u00f8se problemet. Jeg vil gerne have svaret skriftligt.';return ['Hej.','',...(q.length?[`Jeg kan se denne forskel: "${q[0].before}" / "${q[0].after||'ikke dokumenteret'}"`,'']:[]),line,'','Med venlig hilsen'].join('\n')}
